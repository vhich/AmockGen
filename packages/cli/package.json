{
  "name": "@vhictor/amockgen",
  "version": "1.0.0",
  "description": "Zero-config stateful API mocking CLI",
  "main": "dist/index.js",
  "bin": {
    "amockgen": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'); const p='dist/index.js'; fs.writeFileSync(p, '#!/usr/bin/env node\\n' + fs.readFileSync(p, 'utf8'));\"",
    "dev": "tsc --watch",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@amockgen/core": "workspace:*",
    "@amockgen/mock-server": "workspace:*",
    "chokidar": "^3.6.0",
    "commander": "^12.0.0",
    "fastify": "^4.26.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
